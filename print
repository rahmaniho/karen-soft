/* ============================================================
   LIGHTBOX
   ============================================================ */
.lightbox { position: fixed; inset: 0; z-index: 9998; display: grid; place-items: center; padding: var(--space-md); background: rgba(4 8 20 / 0.94); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); opacity: 0; visibility: hidden; transition: opacity 0.4s, visibility 0.4s; }
.lightbox.is-open { opacity: 1; visibility: visible; }
.lightbox__content { max-width: min(92vw, 1100px); max-height: 88dvh; border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 40px 100px -20px rgba(0 0 0 / 0.9), 0 0 60px -20px oklch(0.72 0.20 45 / 0.5); transform: scale(0.9) translateY(20px); opacity: 0; transition: transform 0.5s var(--ease-spring), opacity 0.4s; position: relative; background: var(--ink-950); }
.lightbox.is-open .lightbox__content { transform: scale(1) translateY(0); opacity: 1; }
.lightbox__content img { display: block; max-width: 92vw; max-height: 88dvh; object-fit: contain; }
.lightbox__caption { position: absolute; inset-inline: 0; bottom: 0; padding: 22px 28px; background: linear-gradient(to top, rgba(4 8 20 / 0.95), transparent); color: #fff; text-align: center; transform: translateY(100%); opacity: 0; transition: transform 0.4s var(--ease-out) 0.15s, opacity 0.4s 0.15s; }
.lightbox.is-open .lightbox__caption { transform: translateY(0); opacity: 1; }
.lightbox__close { position: absolute; top: 16px; right: 16px; width: 52px; height: 52px; display: grid; place-items: center; border-radius: 50%; background: rgba(255 255 255 / 0.12); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--border-strong); color: #fff; font-size: 1.3rem; z-index: 3; transition: all 0.4s var(--ease-spring); }
.lightbox__close:hover { background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); transform: rotate(90deg) scale(1.1); border-color: transparent; }

/* ============================================================
   ANIMATIONS
   ============================================================ */
@keyframes ping { 0% { box-shadow: 0 0 0 0 oklch(0.72 0.17 155 / 0.6); } 70%, 100% { box-shadow: 0 0 0 10px oklch(0.72 0.17 155 / 0); } }
@keyframes bounce-dot { 0%, 80%, 100% { transform: translateY(0); opacity: 0.4; } 40% { transform: translateY(-8px); opacity: 1; } }
@keyframes marquee-rtl { from { transform: translateX(-50%); } to { transform: translateX(0); } }
@keyframes spin-slow { to { transform: rotate(360deg); } }
@keyframes shine { 0% { left: -120%; } 40%, 100% { left: 120%; } }
@keyframes beat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.2); } }
@keyframes slide-down { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
[data-reveal] { opacity: 0; transform: translateY(30px); transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out); }
[data-reveal].is-visible { opacity: 1; transform: none; }
@media (scripting: none) { [data-reveal] { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) {
  [data-reveal] { opacity: 1; transform: none; transition: none; }
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}

