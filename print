button { background: none; border: none; cursor: pointer; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; }
:focus-visible { outline: 2px solid var(--accent-500); outline-offset: 3px; border-radius: 4px; }
::selection { background: var(--accent-500); color: #fff; }

body {
  font-family: var(--font-body);
  font-size: var(--fs-base);
  color: var(--text);
  background: var(--bg);
  overflow-x: hidden;
  position: relative;
  isolation: isolate;
}

body::before {
  content: '';
  position: fixed; inset: 0;
  z-index: -2;
  background-image: url('https://karen-soft.ir/images/chapkhaneh.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
body::after {
  content: '';
  position: fixed; inset: 0;
  z-index: -1;
  background:
    radial-gradient(ellipse 100% 60% at 50% 0%, oklch(0.30 0.15 260 / 0.6), transparent 70%),
    radial-gradient(ellipse 80% 50% at 80% 100%, oklch(0.35 0.20 45 / 0.35), transparent 70%),
    linear-gradient(180deg, oklch(0.10 0.03 262 / 0.85), oklch(0.08 0.02 262 / 0.92));
  pointer-events: none;
}

h1, h2, h3, h4 { line-height: var(--lh-snug); font-weight: 700; letter-spacing: -0.015em; text-wrap: balance; }
p { text-wrap: pretty; }
.container { width: min(100% - 2rem, var(--container)); margin-inline: auto; }
.page { position: relative; z-index: 1; }
section { padding-block: var(--space-2xl); position: relative; scroll-margin-top: 100px; }

/* ============================================================
   FONT DISPLAY USAGE
   ============================================================ */
.hero__title {
  font-family: var(--font-display);
  font-size: var(--fs-5xl);
  line-height: 1.4;
  font-weight: 400;
  color: #fff;
  margin-bottom: var(--space-md);
  text-shadow: 0 4px 24px rgba(0 0 0 / 0.5);
}
.hero__title em {
  font-style: normal;
  background: linear-gradient(135deg, oklch(0.85 0.10 250), var(--accent-400) 60%, var(--accent-500));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.section-head h2 {
  font-family: var(--font-display);
  font-size: var(--fs-4xl);
  font-weight: 400;
  line-height: 1.45;
  color: #fff;
  text-shadow: 0 4px 24px rgba(0 0 0 / 0.5);
}
.brand-box__title {
  font-family: var(--font-display);
  font-size: 1.85rem;
  color: #fff;
  line-height: 1.4;
  text-shadow: 0 2px 12px oklch(0.72 0.20 45 / 0.3);
}
.nav__brand-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  line-height: 1.35;
  color: #fff;
}
.footer__cta h3 {
  font-family: var(--font-display);
  font-size: var(--fs-2xl);
  font-weight: 400;
  color: #fff;
  margin-bottom: 4px;
  line-height: 1.45;
}
.slide__title {
  font-family: var(--font-display);
  font-size: var(--fs-3xl);
  font-weight: 400;
  line-height: 1.45;
  margin-bottom: 6px;
  text-shadow: 0 4px 20px rgba(0 0 0 / 0.6);
}
.lightbox__caption {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: var(--fs-lg);
  line-height: 1.5;
}

/* ============================================================
   LOADER — با لوگو داخل دایره + انیمیشن چرخان
   ============================================================ */
.loader {
  position: fixed; inset: 0; z-index: 9999;
  display: grid; place-content: center; gap: var(--space-lg);
  background: radial-gradient(circle at 50% 50%, oklch(0.18 0.08 260), var(--ink-950) 70%);
  transition: opacity 0.8s var(--ease-out), visibility 0.8s;
  text-align: center;
  padding: var(--space-md);
}
.loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }

.loader__stage {
  position: relative;
  width: 220px;
  height: 220px;
  margin-inline: auto;
  display: grid;
  place-items: center;
}

/* هاله نورانی پشت لوگو */
.loader__stage::before {
  content: '';
  position: absolute;
  inset: -20px;
  background: radial-gradient(circle, oklch(0.72 0.20 45 / 0.25), transparent 65%);
  filter: blur(30px);
  border-radius: 50%;
  animation: pulse-halo 2.5s ease-in-out infinite;
}
@keyframes pulse-halo {
  0%, 100% { opacity: 0.6; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.08); }
}

/* حلقه چرخان SVG */
.loader__svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
  z-index: 2;
}
.loader__svg .track {
  fill: none;
  stroke: rgba(255 255 255 / 0.08);
  stroke-width: 4;
}
.loader__svg .progress {
  fill: none;
  stroke: url(#loaderGradient);
  stroke-width: 4;
  stroke-linecap: round;
  stroke-dasharray: 691; /* 2 * PI * 110 (r=110) */
  stroke-dashoffset: 691;
  transition: stroke-dashoffset 0.1s linear;
  filter: drop-shadow(0 0 12px oklch(0.72 0.20 45 / 0.8));
}

/* نقطه نورانی روی حلقه */
.loader__dot {
  position: absolute;
  width: 8px;
  height: 8px;
  background: radial-gradient(circle, #fff, var(--accent-400));
  border-radius: 50%;
  box-shadow: 0 0 12px var(--accent-500), 0 0 24px oklch(0.72 0.20 45 / 0.6);
  top: 50%;
  left: 0;
  transform-origin: 110px 0;
  transform: translate(-50%, -50%) rotate(0deg);
  z-index: 3;
  transition: transform 0.1s linear;
}

/* لوگو داخل دایره */
.loader__logo-wrap {
  position: relative;
  z-index: 4;
  width: 150px;
  height: 150px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, rgba(255 255 255 / 0.06), transparent 70%);
  animation: logo-breathe 3s ease-in-out infinite;
}
@keyframes logo-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
.loader__logo {
  width: 130px;
  height: 130px;
  object-fit: contain;
  filter: drop-shadow(0 8px 28px oklch(0.72 0.20 45 / 0.55))
          drop-shadow(0 4px 12px rgba(0 0 0 / 0.3));
}

/* درصد پایین */
.loader__progress-text {
  position: absolute;
  bottom: -46px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: baseline;
  gap: 4px;
  font-family: var(--font-body);
  direction: ltr;
  z-index: 5;
}
.loader__percent {
  font-size: 1.9rem;
  font-weight: 900;
  background: linear-gradient(135deg, #fff 20%, var(--accent-400));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  min-width: 3.5ch;
  text-align: center;
}
.loader__sym {
  font-size: 0.85rem;
  color: var(--text-dim);
  font-weight: 600;
  direction: rtl;
}

/* نوار پیشرفت خطی پایین */
.loader__bar {
  position: absolute;
  bottom: -70px;
  left: 50%;
  transform: translateX(-50%);
  width: 180px;
  height: 3px;
  background: rgba(255 255 255 / 0.08);
  border-radius: 3px;
  overflow: hidden;
  z-index: 5;
}
.loader__bar-fill {
  display: block;
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--brand-500), var(--accent-500), var(--accent-400));
  border-radius: 3px;
  box-shadow: 0 0 12px oklch(0.72 0.20 45 / 0.8);
  transition: width 0.1s linear;
}

/* متن پایین لودر */
.loader__label {
  color: var(--text-muted);
  font-size: var(--fs-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 70px;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.loader__dots { display: inline-flex; gap: 4px; }
.loader__dots span {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--accent-500);
  animation: bounce-dot 1.4s infinite ease-in-out;
}
.loader__dots span:nth-child(2) { animation-delay: 0.15s; }
.loader__dots span:nth-child(3) { animation-delay: 0.3s; }

/* برند کارن سافت زیر لودر */
.loader__brand {
  margin-top: var(--space-md);
  font-size: 0.72rem;
  color: var(--text-dim);
  letter-spacing: 0.05em;
  font-weight: 500;
  opacity: 0.7;
}
.loader__brand a {
  color: var(--brand-300);
  transition: color 0.3s;
  font-weight: 700;
}
.loader__brand a:hover { color: var(--accent-400); }

@media (max-width: 480px) {
  .loader__stage { width: 180px; height: 180px; }
  .loader__logo-wrap { width: 120px; height: 120px; }
  .loader__logo { width: 105px; height: 105px; }
  .loader__percent { font-size: 1.6rem; }
  .loader__bar { width: 150px; }
}

/* ============================================================
   HEADER
   ============================================================ */
.header { position: fixed; top: var(--space-md); left: 50%; transform: translateX(-50%); z-index: 100; width: min(100% - 2rem, 1400px); transition: transform 0.5s var(--ease-spring), opacity 0.4s; will-change: transform; }
.header.is-hidden { transform: translate(-50%, -140%); opacity: 0; }

.nav { display: flex; align-items: center; gap: var(--space-sm); padding: 10px 10px 10px 20px; border-radius: var(--radius-full); background: rgba(15 23 42 / 0.55); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); border: 1px solid var(--border); box-shadow: 0 20px 50px -20px rgba(0 0 0 / 0.7), inset 0 1px 0 rgba(255 255 255 / 0.08); }
.nav__brand { display: inline-flex; align-items: center; gap: 10px; padding-inline-end: var(--space-sm); border-inline-end: 1px solid var(--border-subtle); margin-inline-end: var(--space-2xs); }
.nav__brand img { height: 42px; width: auto; filter: drop-shadow(0 4px 12px oklch(0.72 0.20 45 / 0.4)); }
.nav__brand-text { display: flex; flex-direction: column; line-height: 1.1; }
.nav__brand-sub { font-size: 0.6rem; color: var(--accent-400); font-weight: 700; letter-spacing: 0.15em; }

.nav__links { display: flex; align-items: center; gap: 2px; flex: 1; }
.nav__link { padding: 10px 14px; font-size: var(--fs-sm); font-weight: 600; color: var(--text-muted); border-radius: var(--radius-full); transition: color 0.25s, background 0.25s; position: relative; white-space: nowrap; }
.nav__link:hover { color: #fff; background: var(--surface-hover); }
.nav__link[aria-current="true"] { color: #fff; }
.nav__link[aria-current="true"]::after { content: ''; position: absolute; bottom: 2px; left: 50%; translate: -50% 0; width: 20px; height: 2px; background: var(--accent-500); border-radius: 2px; }

.nav__cta { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; font-size: var(--fs-sm); font-weight: 700; color: #fff; background: linear-gradient(135deg, var(--brand-600), var(--brand-500)); border-radius: var(--radius-full); box-shadow: 0 8px 24px -8px oklch(0.58 0.19 255 / 0.6); transition: transform 0.3s var(--ease-spring), box-shadow 0.3s; }
.nav__cta:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 12px 30px -8px oklch(0.72 0.20 45 / 0.7); }

.nav__toggle { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); border: 1px solid var(--border-subtle); }
.nav__toggle svg { width: 20px; height: 20px; }

@media (max-width: 1024px) {
  .nav__links { display: none; }
  .nav__toggle { display: inline-flex; }
  .nav { padding: 8px 8px 8px 16px; }
  .nav__brand-title { font-size: 1.05rem; }
  .nav__brand-sub { display: none; }
  .nav__brand img { height: 36px; }
}
@media (max-width: 520px) {
  .nav__cta span { display: none; }
  .nav__cta { padding: 10px 14px; }
}

/* ============================================================
   MOBILE DRAWER
   ============================================================ */
.drawer { position: fixed; inset: 0; z-index: 90; background: rgba(8 12 26 / 0.4); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); opacity: 0; visibility: hidden; transition: opacity 0.4s var(--ease-out), visibility 0.4s; }
.drawer.is-open { opacity: 1; visibility: visible; }
.drawer__panel { position: absolute; inset-inline: 16px; top: 96px; padding: var(--space-md); border-radius: var(--radius-lg); background: rgba(15 23 42 / 0.92); backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%); border: 1px solid var(--border); box-shadow: var(--shadow-xl); transform: translateY(-20px) scale(0.98); transition: transform 0.5s var(--ease-spring); }
.drawer.is-open .drawer__panel { transform: translateY(0) scale(1); }
.drawer__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.drawer__item { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border-subtle); color: var(--text-muted); font-weight: 600; font-size: var(--fs-sm); transition: all 0.3s var(--ease-out); }
.drawer__item:hover { color: #fff; background: var(--surface-hover); transform: translateY(-2px); border-color: var(--accent-500); }
.drawer__item i { font-size: 1.4rem; font-style: normal; }
.drawer__item--cta { grid-column: 1 / -1; background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); border-color: transparent; color: #fff; justify-content: center; }

/* ============================================================
   HERO
   ============================================================ */
.hero { padding-top: calc(var(--space-2xl) + 80px); padding-bottom: var(--space-2xl); position: relative; overflow: hidden; }
.hero__grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-xl); align-items: center; }
@media (max-width: 960px) { .hero__grid { grid-template-columns: 1fr; } }

.chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: var(--radius-full); background: rgba(255 255 255 / 0.08); border: 1px solid var(--border); backdrop-filter: blur(10px); font-size: var(--fs-xs); font-weight: 700; color: #fff; margin-bottom: var(--space-md); line-height: 1.6; }
.chip__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); animation: ping 2s ease-out infinite; flex-shrink: 0; }
.chip__text { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }

.hero__lead { font-size: var(--fs-lg); color: var(--text-muted); line-height: var(--lh-relaxed); margin-bottom: var(--space-lg); max-width: 56ch; }
.hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-lg); }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 26px; border-radius: var(--radius); font-weight: 700; font-size: var(--fs-sm); transition: transform 0.3s var(--ease-spring), box-shadow 0.3s, background 0.3s; cursor: pointer; white-space: nowrap; border: 1px solid transparent; font-family: var(--font-body); }
.btn--primary { background: linear-gradient(135deg, var(--brand-600), var(--brand-500) 60%, var(--accent-500)); color: #fff; box-shadow: 0 12px 30px -10px oklch(0.58 0.19 255 / 0.6); position: relative; overflow: hidden; }
.btn--primary::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); opacity: 0; transition: opacity 0.4s; }
.btn--primary > * { position: relative; z-index: 1; }
.btn--primary:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -12px oklch(0.72 0.20 45 / 0.7); }
.btn--primary:hover::before { opacity: 1; }
.btn--ghost { background: rgba(255 255 255 / 0.06); color: #fff; border-color: var(--border); backdrop-filter: blur(10px); }
.btn--ghost:hover { background: rgba(255 255 255 / 0.12); border-color: var(--border-strong); transform: translateY(-3px); }

.hero__stats { display: flex; gap: var(--space-lg); flex-wrap: wrap; padding-top: var(--space-md); border-top: 1px solid var(--border-subtle); }
.hero__stat { display: flex; flex-direction: column; }
.hero__stat strong { font-size: var(--fs-2xl); font-weight: 900; background: linear-gradient(135deg, #fff, var(--accent-400)); -webkit-background-clip: text; background-clip: text; color: transparent; line-height: 1; }
.hero__stat span { font-size: var(--fs-xs); color: var(--text-dim); margin-top: 4px; }

.hero__visual { position: relative; aspect-ratio: 1; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); gap: var(--space-sm); max-width: 520px; margin-inline: auto; }
.tile { border-radius: var(--radius-md); overflow: hidden; position: relative; background: rgba(15 23 42 / 0.6); border: 1px solid var(--border); backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%); box-shadow: var(--shadow-lg); cursor: pointer; transition: transform 0.5s var(--ease-spring), box-shadow 0.4s, border-color 0.3s; }
.tile:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 30px 60px -20px oklch(0.72 0.20 45 / 0.45); border-color: oklch(0.72 0.20 45 / 0.6); z-index: 3; }
.tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
.tile:hover img { transform: scale(1.08); }
.tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8 12 26 / 0.85), transparent 55%); pointer-events: none; }
.tile__cap { position: absolute; inset-inline: 12px; bottom: 10px; z-index: 1; color: #fff; }
.tile__cap strong { display: block; font-size: var(--fs-sm); font-weight: 700; }
.tile__cap span { display: block; font-size: var(--fs-xs); color: var(--accent-400); font-weight: 600; }
.tile--hero { grid-area: 1 / 1 / 3 / 3; border-radius: var(--radius-lg); }
.tile--a { grid-area: 1 / 3 / 2 / 4; }
.tile--b { grid-area: 3 / 1 / 4 / 2; }
.tile--c { grid-area: 2 / 3 / 4 / 4; }
@media (max-width: 520px) { .hero__visual { gap: 8px; } .tile__cap { inset-inline: 8px; bottom: 6px; } .tile__cap strong { font-size: 0.7rem; } .tile__cap span { display: none; } }

/* ============================================================
   MARQUEE
   ============================================================ */
.marquee { padding-block: var(--space-md); border-block: 1px solid var(--border-subtle); overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
.marquee__track { display: flex; gap: var(--space-2xl); width: max-content; animation: marquee-rtl 40s linear infinite; will-change: transform; }
.marquee:hover .marquee__track { animation-play-state: paused; }
.marquee__item { display: inline-flex; align-items: center; gap: 10px; font-size: var(--fs-sm); font-weight: 700; color: var(--text-dim); white-space: nowrap; transition: color 0.3s; }
.marquee__item:hover { color: var(--accent-400); }

/* ============================================================
   SECTION HEAD
   ============================================================ */
.section-head { max-width: 720px; margin: 0 auto var(--space-xl); text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
.eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: var(--radius-full); background: linear-gradient(135deg, oklch(0.72 0.20 45 / 0.15), oklch(0.58 0.19 255 / 0.15)); border: 1px solid oklch(0.72 0.20 45 / 0.3); color: var(--accent-400); font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.08em; backdrop-filter: blur(8px); }
.section-head p { color: var(--text-muted); font-size: var(--fs-base); max-width: 60ch; line-height: var(--lh-relaxed); }

/* ============================================================
   SERVICES
   ============================================================ */
.services { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--space-md); }
.service { grid-column: span 4; border-radius: var(--radius-lg); background: linear-gradient(160deg, rgba(255 255 255 / 0.06), rgba(255 255 255 / 0.02)); border: 1px solid var(--border); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); overflow: hidden; transition: transform 0.5s var(--ease-spring), box-shadow 0.4s, border-color 0.3s; position: relative; box-shadow: var(--shadow-lg); }
.service::before { content: ''; position: absolute; inset-inline: 0; top: 0; height: 3px; background: linear-gradient(90deg, var(--brand-500), var(--accent-500)); transform: scaleX(0); transform-origin: right; transition: transform 0.5s var(--ease-out); z-index: 2; }
.service:hover { transform: translateY(-8px); box-shadow: 0 30px 70px -25px oklch(0.72 0.20 45 / 0.4); border-color: var(--border-strong); }
.service:hover::before { transform: scaleX(1); }
.service__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; cursor: zoom-in; }
.service__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s var(--ease-out); }
.service:hover .service__media img { transform: scale(1.07); }
.service__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8 12 26 / 0.55), transparent 60%); opacity: 0; transition: opacity 0.4s; }
.service:hover .service__media::after { opacity: 1; }
.service__tag { position: absolute; top: 12px; right: 12px; z-index: 1; padding: 5px 12px; border-radius: var(--radius-full); background: rgba(8 12 26 / 0.7); backdrop-filter: blur(10px); border: 1px solid var(--border); color: #fff; font-size: var(--fs-xs); font-weight: 700; }
.service__body { padding: var(--space-md); }
.service__body h3 { font-family: var(--font-body); font-size: var(--fs-xl); font-weight: 800; margin-bottom: 8px; color: #fff; letter-spacing: -0.01em; }
.service__body > p { color: var(--text-muted); font-size: var(--fs-sm); margin-bottom: var(--space-sm); line-height: var(--lh-normal); }
.service__list { display: flex; flex-direction: column; gap: 8px; }
.service__list li { display: flex; align-items: center; gap: 10px; font-size: var(--fs-sm); color: var(--ink-200); }
.service__list li::before { content: ''; flex-shrink: 0; width: 18px; height: 18px; border-radius: 50%; background: radial-gradient(circle at center, var(--success) 30%, transparent 32%), radial-gradient(circle at center, oklch(0.72 0.17 155 / 0.2) 60%, transparent 62%); display: inline-block; }
@media (max-width: 960px) { .service { grid-column: span 6; } }
@media (max-width: 640px) { .service { grid-column: span 12; } }

/* ============================================================
   FEATURES
   ============================================================ */
.features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--space-sm); }
.feature { text-align: center; padding: var(--space-lg) var(--space-md); border-radius: var(--radius-lg); background: linear-gradient(160deg, rgba(255 255 255 / 0.05), rgba(255 255 255 / 0.02)); border: 1px solid var(--border); backdrop-filter: blur(16px) saturate(160%); -webkit-backdrop-filter: blur(16px) saturate(160%); transition: transform 0.4s var(--ease-spring), border-color 0.3s, box-shadow 0.4s; position: relative; overflow: hidden; }
.feature:hover { transform: translateY(-6px); box-shadow: var(--shadow-xl); border-color: oklch(0.72 0.20 45 / 0.4); }
.feature__icon { width: 60px; height: 60px; margin: 0 auto var(--space-sm); display: grid; place-items: center; border-radius: 18px; background: linear-gradient(135deg, oklch(0.58 0.19 255 / 0.2), oklch(0.72 0.20 45 / 0.2)); border: 1px solid var(--border); font-size: 1.7rem; transition: transform 0.4s var(--ease-spring); }
.feature:hover .feature__icon { transform: rotate(-8deg) scale(1.1); }
.feature h4 { font-size: var(--fs-lg); color: #fff; margin-bottom: 6px; }
.feature p { font-size: var(--fs-sm); color: var(--text-muted); }

/* ============================================================
   PROCESS
   ============================================================ */
.process { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: var(--space-md); position: relative; }
.process::before { content: ''; position: absolute; top: 40px; inset-inline: 10%; height: 1px; background: linear-gradient(90deg, transparent, var(--border-strong), transparent); z-index: 0; }
@media (max-width: 900px) { .process::before { display: none; } }
.step { position: relative; text-align: center; padding: var(--space-xl) var(--space-md) var(--space-md); border-radius: var(--radius-lg); background: rgba(255 255 255 / 0.04); border: 1px solid var(--border); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); transition: transform 0.4s var(--ease-spring), border-color 0.3s; z-index: 1; }
.step:hover { transform: translateY(-6px); border-color: oklch(0.72 0.20 45 / 0.5); }
.step__num { position: absolute; top: -22px; left: 50%; transform: translateX(-50%); width: 56px; height: 56px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(135deg, var(--brand-600), var(--brand-500)); border: 3px solid var(--ink-950); color: #fff; font-family: var(--font-body); font-weight: 900; font-size: var(--fs-lg); box-shadow: 0 12px 30px -8px oklch(0.58 0.19 255 / 0.7); }
.step h4 { font-size: var(--fs-lg); color: #fff; margin-bottom: 8px; }
.step p { font-size: var(--fs-sm); color: var(--text-muted); }

/* ============================================================
   SLIDESHOW
   ============================================================ */
.slideshow { position: relative; }
.slideshow__stage { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-xl); overflow: hidden; background: rgba(8 12 26 / 0.7); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--border); box-shadow: var(--shadow-xl), inset 0 1px 0 rgba(255 255 255 / 0.08); }
@media (max-width: 640px) { .slideshow__stage { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); } }
.slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 0.9s var(--ease-out), visibility 0.9s; cursor: zoom-in; z-index: 1; }
.slide.is-active { opacity: 1; visibility: visible; z-index: 3; }
.slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); transition: transform 8s linear; }
.slide.is-active img { transform: scale(1); }
.slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8 12 26 / 0.95) 0%, rgba(8 12 26 / 0.3) 45%, transparent 70%), linear-gradient(135deg, oklch(0.38 0.18 260 / 0.3), transparent 55%); pointer-events: none; }
.slide__caption { position: absolute; inset-inline: 0; bottom: 0; padding: var(--space-lg) var(--space-xl); z-index: 4; transform: translateY(30px); opacity: 0; transition: transform 0.7s var(--ease-out) 0.3s, opacity 0.7s 0.3s; color: #fff; pointer-events: none; }
.slide.is-active .slide__caption { transform: translateY(0); opacity: 1; }
.slide__badge { display: inline-block; padding: 5px 12px; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); color: #fff; font-size: var(--fs-xs); font-weight: 700; margin-bottom: 10px; box-shadow: 0 6px 18px -4px oklch(0.72 0.20 45 / 0.6); }
.slide__desc { font-size: var(--fs-sm); color: rgba(255 255 255 / 0.85); max-width: 55ch; line-height: var(--lh-normal); }
@media (max-width: 640px) { .slide__caption { padding: var(--space-md); } .slide__title { font-size: var(--fs-xl); } .slide__desc { font-size: var(--fs-xs); } }
.slide__nav { position: absolute; top: 50%; translate: 0 -50%; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: rgba(255 255 255 / 0.14); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--border-strong); color: #fff; font-size: 1.4rem; z-index: 10; transition: all 0.3s var(--ease-spring); }
.slide__nav:hover { background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); border-color: transparent; transform: translateY(-50%) scale(1.1); box-shadow: 0 12px 30px -8px oklch(0.72 0.20 45 / 0.7); }
.slide__nav--prev { right: 16px; }
.slide__nav--next { left: 16px; }
@media (max-width: 640px) { .slide__nav { width: 42px; height: 42px; font-size: 1.1rem; } .slide__nav--prev { right: 10px; } .slide__nav--next { left: 10px; } }
.slide__counter { position: absolute; top: 18px; right: 18px; padding: 8px 16px; border-radius: var(--radius-full); background: rgba(8 12 26 / 0.65); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--border); color: #fff; display: flex; align-items: center; gap: 6px; font-size: var(--fs-xs); font-weight: 700; z-index: 10; }
.slide__counter b { color: var(--accent-400); font-family: var(--font-body); font-size: var(--fs-lg); font-weight: 700; }
.slide__progress { position: absolute; inset-inline: 0; bottom: 0; height: 3px; background: rgba(255 255 255 / 0.08); z-index: 10; overflow: hidden; }
.slide__progress > i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--brand-500), var(--accent-500), var(--accent-400)); box-shadow: 0 0 12px oklch(0.72 0.20 45 / 0.9); }

.thumbs { display: flex; justify-content: center; gap: 10px; margin-top: var(--space-md); padding: 14px; background: rgba(255 255 255 / 0.05); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow-x: auto; scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: oklch(0.72 0.20 45 / 0.5) transparent; box-shadow: var(--shadow); }
.thumbs::-webkit-scrollbar { height: 4px; }
.thumbs::-webkit-scrollbar-thumb { background: oklch(0.72 0.20 45 / 0.5); border-radius: 4px; }
.thumb { flex: 0 0 auto; width: 76px; height: 54px; border-radius: var(--radius-sm); overflow: hidden; cursor: pointer; border: 2px solid transparent; opacity: 0.5; filter: grayscale(70%); transition: all 0.35s var(--ease-out); padding: 0; background: transparent; }
.thumb img { width: 100%; height: 100%; object-fit: cover; }
.thumb:hover { opacity: 0.85; filter: grayscale(20%); transform: scale(1.02); }
.thumb.is-active { opacity: 1; filter: none; border-color: var(--accent-500); transform: scale(1.08); box-shadow: 0 10px 25px -8px oklch(0.72 0.20 45 / 0.6); }

/* ============================================================
   GALLERY
   ============================================================ */
.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: var(--space-sm); }
.gallery--tracts { grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
.gallery__item { position: relative; aspect-ratio: 1; border-radius: var(--radius-md); overflow: hidden; background: rgba(255 255 255 / 0.9); border: 1px solid var(--border); cursor: zoom-in; transition: transform 0.5s var(--ease-spring), box-shadow 0.4s, border-color 0.3s; box-shadow: var(--shadow); }
.gallery--tracts .gallery__item { aspect-ratio: 4 / 5; }
.gallery__item:hover { transform: translateY(-8px) scale(1.02); border-color: oklch(0.72 0.20 45 / 0.6); box-shadow: 0 30px 60px -20px oklch(0.72 0.20 45 / 0.45); z-index: 2; }
.gallery__item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
.gallery__item:hover img { transform: scale(1.08); }
.gallery__item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8 12 26 / 0.9), transparent 55%); opacity: 0; transition: opacity 0.4s; }
.gallery__item:hover::after { opacity: 1; }
.gallery__label { position: absolute; bottom: 12px; right: 12px; z-index: 2; padding: 5px 12px; border-radius: var(--radius-full); background: rgba(8 12 26 / 0.75); backdrop-filter: blur(10px); border: 1px solid var(--border); color: #fff; font-size: var(--fs-xs); font-weight: 700; }
.gallery__badge { position: absolute; top: 12px; right: 12px; z-index: 2; padding: 4px 10px; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); color: #fff; font-size: 0.68rem; font-weight: 700; box-shadow: 0 6px 14px -4px oklch(0.72 0.20 45 / 0.6); }
.gallery__cap { position: absolute; inset-inline: 0; bottom: 0; padding: 16px; color: #fff; z-index: 3; transform: translateY(15px); opacity: 0; transition: all 0.4s var(--ease-out); }
.gallery__item:hover .gallery__cap { transform: translateY(0); opacity: 1; }
.gallery__cap h4 { font-size: var(--fs-base); margin-bottom: 2px; }
.gallery__cap p { font-size: var(--fs-xs); opacity: 0.8; }

/* ============================================================
   ADS
   ============================================================ */
.ads { margin-top: var(--space-lg); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
@media (max-width: 900px) { .ads { grid-template-columns: 1fr; } }
.ads__media { border-radius: var(--radius-lg); overflow: hidden; cursor: zoom-in; border: 1px solid var(--border); box-shadow: var(--shadow-lg); transition: transform 0.4s var(--ease-spring); position: relative; }
.ads__media:hover { transform: translateY(-6px); }
.ads__media img { width: 100%; height: 100%; min-height: 280px; object-fit: cover; transition: transform 0.6s var(--ease-out); }
.ads__media:hover img { transform: scale(1.05); }
.ads__info { border-radius: var(--radius-lg); padding: var(--space-lg); background: linear-gradient(160deg, rgba(255 255 255 / 0.06), rgba(255 255 255 / 0.02)); border: 1px solid var(--border); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); display: flex; flex-direction: column; justify-content: center; box-shadow: var(--shadow-lg); }
.ads__info h3 { font-family: var(--font-body); font-size: var(--fs-2xl); font-weight: 800; color: #fff; margin-bottom: var(--space-sm); line-height: 1.4; letter-spacing: -0.02em; }
.ads__info p { color: var(--text-muted); font-size: var(--fs-sm); margin-bottom: var(--space-md); line-height: var(--lh-relaxed); }
.ads__list { display: flex; flex-direction: column; gap: 10px; }
.ads__list li { display: flex; align-items: center; gap: 12px; font-size: var(--fs-sm); color: var(--ink-200); }
.ads__list li::before { content: '✦'; flex-shrink: 0; width: 26px; height: 26px; display: grid; place-items: center; border-radius: 8px; background: linear-gradient(135deg, oklch(0.58 0.19 255 / 0.2), oklch(0.72 0.20 45 / 0.2)); color: var(--accent-400); font-size: 0.75rem; font-weight: 800; }

/* ============================================================
   TESTIMONIALS
   ============================================================ */
.testimonials { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-md); }
.testi { padding: var(--space-lg); border-radius: var(--radius-lg); background: linear-gradient(160deg, rgba(255 255 255 / 0.05), rgba(255 255 255 / 0.02)); border: 1px solid var(--border); backdrop-filter: blur(16px) saturate(160%); -webkit-backdrop-filter: blur(16px) saturate(160%); transition: transform 0.4s var(--ease-spring), border-color 0.3s; box-shadow: var(--shadow-lg); }
.testi:hover { transform: translateY(-6px); border-color: oklch(0.72 0.20 45 / 0.45); }
.testi__stars { color: var(--warning); letter-spacing: 3px; margin-bottom: var(--space-sm); font-size: var(--fs-base); }
.testi p { color: var(--ink-200); font-size: var(--fs-sm); margin-bottom: var(--space-md); line-height: var(--lh-relaxed); }
.testi__author { display: flex; align-items: center; gap: 12px; }
.testi__avatar { width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, var(--brand-600), var(--accent-500)); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: var(--fs-base); box-shadow: 0 8px 20px -8px oklch(0.72 0.20 45 / 0.6); }
.testi__name { font-weight: 700; font-size: var(--fs-sm); color: #fff; }
.testi__role { font-size: var(--fs-xs); color: var(--text-dim); }

/* ============================================================
   FAQ
   ============================================================ */
.faq { max-width: 860px; margin-inline: auto; display: flex; flex-direction: column; gap: var(--space-xs); }
.faq__item { border-radius: var(--radius-md); background: rgba(255 255 255 / 0.04); border: 1px solid var(--border); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); overflow: hidden; transition: border-color 0.3s, background 0.3s; }
.faq__item[open] { border-color: oklch(0.72 0.20 45 / 0.45); background: rgba(255 255 255 / 0.06); }
.faq__item summary { list-style: none; padding: 20px 22px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); cursor: pointer; font-weight: 700; font-size: var(--fs-base); color: #fff; transition: color 0.3s; }
.faq__item summary::-webkit-details-marker { display: none; }
.faq__item summary::after { content: '+'; flex-shrink: 0; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: oklch(0.58 0.19 255 / 0.2); color: var(--brand-300); font-size: 1.1rem; font-weight: 800; transition: all 0.4s var(--ease-spring); }
.faq__item[open] summary::after { background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); color: #fff; transform: rotate(45deg); }
.faq__answer { padding: 0 22px 20px; color: var(--text-muted); font-size: var(--fs-sm); line-height: var(--lh-relaxed); animation: slide-down 0.4s var(--ease-out); }

/* ============================================================
   CONTACT
   ============================================================ */
.contact { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-lg); align-items: start; }
@media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
.form { padding: var(--space-lg); border-radius: var(--radius-lg); background: linear-gradient(160deg, rgba(255 255 255 / 0.08), rgba(255 255 255 / 0.03)); border: 1px solid var(--border); backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%); box-shadow: var(--shadow-xl); }
.form__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
@media (max-width: 600px) { .form__row { grid-template-columns: 1fr; } }
.field { margin-bottom: var(--space-sm); display: flex; flex-direction: column; gap: 8px; }
.field label { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-200); }
.field input, .field select, .field textarea { width: 100%; padding: 13px 16px; border-radius: 12px; border: 1.5px solid var(--border); background: rgba(255 255 255 / 0.06); color: #fff; font-size: var(--fs-sm); font-family: var(--font-body); transition: border-color 0.25s, background 0.25s, box-shadow 0.25s; }
.field input::placeholder, .field textarea::placeholder { color: var(--text-dim); }
.field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--accent-500); background: rgba(255 255 255 / 0.09); box-shadow: 0 0 0 4px oklch(0.72 0.20 45 / 0.15); }
.field select option { background: var(--ink-950); color: #fff; }
.field textarea { resize: vertical; min-height: 110px; }
.contact__info { display: flex; flex-direction: column; gap: var(--space-xs); }
.info { display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: var(--radius-md); background: rgba(255 255 255 / 0.06); border: 1px solid var(--border); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); transition: transform 0.3s var(--ease-spring), background 0.3s, border-color 0.3s; }
.info:hover { transform: translateX(-6px); background: rgba(255 255 255 / 0.09); border-color: var(--border-strong); }
.info__icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 14px; background: linear-gradient(135deg, oklch(0.58 0.19 255 / 0.2), oklch(0.72 0.20 45 / 0.2)); border: 1px solid var(--border); font-size: 1.4rem; flex-shrink: 0; }
.info__label { font-size: var(--fs-xs); color: var(--text-dim); margin-bottom: 2px; }
.info__value { font-size: var(--fs-base); font-weight: 700; color: #fff; line-height: 1.5; }
.info__value a { transition: color 0.3s; }
.info__value a:hover { color: var(--accent-400); }

/* ============================================================
   BACK TO TOP
   ============================================================ */
.to-top { position: fixed; bottom: 24px; right: 24px; z-index: 50; width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, var(--brand-600), var(--brand-500)); color: #fff; display: grid; place-items: center; box-shadow: 0 12px 30px -8px oklch(0.58 0.19 255 / 0.7); opacity: 0; visibility: hidden; transform: translateY(20px); transition: all 0.4s var(--ease-spring); }
.to-top.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
.to-top:hover { background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); transform: translateY(-4px) scale(1.08); box-shadow: 0 18px 40px -10px oklch(0.72 0.20 45 / 0.7); }
@media (max-width: 640px) { .to-top { bottom: 16px; right: 16px; width: 46px; height: 46px; } }

/* ============================================================
   FOOTER
   ============================================================ */
.footer { position: relative; margin-top: var(--space-2xl); background: linear-gradient(180deg, rgba(8 15 32 / 0.85), rgba(4 8 20 / 0.98)); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border-top: 1px solid var(--border); overflow: hidden; }
.footer::before { content: ''; position: absolute; top: 0; inset-inline: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--brand-500), var(--accent-500), var(--brand-500), transparent); }
.footer__cta { padding-block: var(--space-lg); border-bottom: 1px solid var(--border-subtle); position: relative; z-index: 1; }
.footer__cta-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); flex-wrap: wrap; }
.footer__cta p { color: var(--text-dim); font-size: var(--fs-sm); }
.footer__actions { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
.footer__main { padding-block: var(--space-xl) var(--space-lg); position: relative; z-index: 1; }
.footer__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: var(--space-xl); }
@media (max-width: 1024px) { .footer__grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); } }
@media (max-width: 600px) { .footer__grid { grid-template-columns: 1fr; } }
.footer__col h4 { color: #fff; font-size: var(--fs-base); font-weight: 700; margin-bottom: var(--space-md); padding-bottom: 12px; position: relative; }
.footer__col h4::after { content: ''; position: absolute; bottom: 0; right: 0; width: 32px; height: 2px; background: linear-gradient(90deg, var(--accent-500), var(--accent-400)); border-radius: 2px; }

.brand-box { position: relative; display: flex; align-items: center; gap: 16px; margin-bottom: var(--space-md); padding: 18px 22px; background: linear-gradient(135deg, oklch(0.58 0.19 255 / 0.15), oklch(0.72 0.20 45 / 0.12)); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--border); border-radius: var(--radius-lg); width: fit-content; overflow: hidden; transition: transform 0.5s var(--ease-spring), box-shadow 0.4s; }
.brand-box::before { content: ''; position: absolute; inset: -2px; border-radius: inherit; padding: 2px; background: conic-gradient(from 0deg, transparent 0deg 40deg, var(--brand-500) 120deg, var(--accent-400) 240deg, transparent 360deg); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; animation: spin-slow 14s linear infinite; opacity: 0; transition: opacity 0.6s; pointer-events: none; }
.brand-box::after { content: ''; position: absolute; top: 0; left: -120%; width: 80%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255 255 255 / 0.12), transparent); animation: shine 6s ease-in-out infinite; pointer-events: none; }
.brand-box:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 20px 50px -15px oklch(0.72 0.20 45 / 0.45); }
.brand-box:hover::before { opacity: 1; }
.brand-box img { height: 68px; width: auto; filter: drop-shadow(0 6px 18px oklch(0.72 0.20 45 / 0.4)); transition: transform 0.5s var(--ease-spring); position: relative; z-index: 1; }
.brand-box:hover img { transform: scale(1.08) rotate(-3deg); }
.brand-box__text { display: flex; flex-direction: column; position: relative; z-index: 1; }
.brand-box__sub { font-size: 0.65rem; color: var(--accent-400); font-weight: 700; letter-spacing: 0.15em; margin-top: 4px; }
@media (max-width: 640px) { .brand-box { padding: 14px 16px; gap: 12px; } .brand-box img { height: 52px; } .brand-box__title { font-size: 1.45rem; } }

.footer__about { color: var(--text-dim); font-size: var(--fs-sm); line-height: var(--lh-relaxed); margin-bottom: var(--space-md); }
.footer__badges { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--space-md); }
