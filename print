.contact-list__label { font-size: var(--fs-xs); color: var(--text-dim); margin-bottom: 2px; }
.contact-list__value { font-size: var(--fs-sm); font-weight: 600; color: var(--ink-200); transition: color 0.3s; line-height: 1.6; }
