<script>
/* ============================================================
   UTILITIES
   ============================================================ */
const $ = (sel, ctx = document) => ctx.querySelector(sel);
const $$ = (sel, ctx = document) => [...ctx.querySelectorAll(sel)];
const toFa = (n) => String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ============================================================
   LAZY FONT LOADING — BLotus
   ============================================================ */
(function loadBLotus() {
  if (!('FontFace' in window)) return;
  const load = () => {
    try {
      const font = new FontFace(
        'BLotus',
        "url('https://karen-soft.ir/font/BLotus.ttf') format('truetype')",
        { style: 'normal', weight: '400', unicodeRange: 'U+0600-06FF, U+200C-200D, U+FB50-FDFF, U+FE70-FEFF' }
      );
      font.load().then((loaded) => {
        document.fonts.add(loaded);
        document.documentElement.classList.add('blotus-loaded');
      }).catch(() => document.documentElement.classList.add('blotus-failed'));
    } catch (e) {
      document.documentElement.classList.add('blotus-failed');
    }
  };
  if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
  else setTimeout(load, 500);
})();

/* ============================================================
   LOADER — انیمیشن دایره‌ای + درصد ۰ تا ۱۰۰ + نوار پیشرفت
   ============================================================ */
(function runLoader() {
  const loader = $('#loader');
  const circle = $('#loaderProgress');
  const dot = $('#loaderDot');
  const numEl = $('#loaderNum');
  const barEl = $('#loaderBar');
  if (!loader || !circle) return;

  const TOTAL = 691; // 2 * PI * 110 (r=110)
  const START = 0;
  const DURATION = prefersReducedMotion ? 500 : 2600;
  const t0 = performance.now();

  const step = (now) => {
    const t = Math.min((now - t0) / DURATION, 1);
    // easeOutCubic
    const eased = 1 - Math.pow(1 - t, 3);
    const pct = START + (100 - START) * eased;

    // به‌روزرسانی حلقه
    circle.style.strokeDashoffset = TOTAL * (1 - pct / 100);

    // چرخش نقطه نورانی
    if (dot) dot.style.transform = `translate(-50%, -50%) rotate(${pct * 3.6}deg)`;

    // به‌روزرسانی درصد
    numEl.textContent = toFa(Math.round(pct));

    // به‌روزرسانی نوار پیشرفت
    if (barEl) barEl.style.width = pct + '%';

    if (t < 1) {
      requestAnimationFrame(step);
    } else {
      // اضافه کردن انیمیشن محو شدن
      setTimeout(() => {
        loader.classList.add('is-hidden');
        document.body.dataset.loaded = 'true';
      }, 400);
    }
  };
  requestAnimationFrame(step);
})();

/* ============================================================
   HEADER — hide on scroll down
   ============================================================ */
(function headerScroll() {
  const header = $('#header');
  let lastY = 0, ticking = false;

  const update = () => {
    const y = window.scrollY;
    if (y > 120 && y > lastY) header?.classList.add('is-hidden');
    else header?.classList.remove('is-hidden');
    lastY = y;
    ticking = false;
  };

  addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
})();

/* ============================================================
   MOBILE DRAWER
   ============================================================ */
(function mobileDrawer() {
  const toggle = $('#navToggle');
  const drawer = $('#drawer');
  if (!toggle || !drawer) return;

  const open = () => {
    drawer.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    drawer.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };
  toggle.addEventListener('click', () => drawer.classList.contains('is-open') ? close() : open());
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer || e.target.closest('[data-close]')) close();
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
})();

/* ============================================================
   SCROLL REVEAL
   ============================================================ */
(function scrollReveal() {
  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    $$('[data-reveal]').forEach(el => el.classList.add('is-visible'));
    return;
  }
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  $$('[data-reveal]').forEach(el => io.observe(el));
})();

/* ============================================================
   LIGHTBOX
   ============================================================ */
(function lightbox() {
  const lb = $('#lightbox');
  const img = $('#lightboxImg');
  const cap = $('#lightboxCaption');
  const closeBtn = $('#lightboxClose');
  if (!lb) return;

  const open = (src, caption) => {
    img.src = src;
    img.alt = caption || '';
    cap.textContent = caption || '';
    lb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  };
  const close = () => {
    lb.classList.remove('is-open');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-lightbox]');
    if (trigger) {
      e.preventDefault();
      open(trigger.dataset.lightbox, trigger.dataset.caption);
    }
  });

  closeBtn.addEventListener('click', close);
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb.classList.contains('is-open')) close(); });

  window.__openLightbox = open;
})();

/* ============================================================
   SLIDESHOW
   ============================================================ */
(function slideshow() {
  const stage = $('#slideStage');
  if (!stage) return;
  const slides = $$('.slide', stage);
  const thumbs = $$('.thumb');
  const currentEl = $('#slideCurrent');
  const progressEl = $('#slideProgress');
  const thumbsContainer = $('#thumbs');
  const total = slides.length;
  const DURATION = 6500;
  let index = 0, rafId = null, startTime = 0, paused = false;

  $('#slideTotal').textContent = toFa(total);

  const showSlide = (i) => {
    slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
    thumbs.forEach((t, k) => t.classList.toggle('is-active', k === i));
    currentEl.textContent = toFa(i + 1);
    scrollThumb(i);
    restart();
  };

  const scrollThumb = (i) => {
    const t = thumbs[i];
    if (!t || !thumbsContainer) return;
    const target = t.offsetLeft - thumbsContainer.clientWidth / 2 + t.offsetWidth / 2;
    thumbsContainer.scrollTo({ left: target, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
  };

  const animate = (now) => {
    if (paused) return;
    const pct = Math.min((now - startTime) / DURATION * 100, 100);
    progressEl.style.width = pct + '%';
    if (pct >= 100) { index = (index + 1) % total; showSlide(index); }
    else rafId = requestAnimationFrame(animate);
  };

  const restart = () => {
    cancelAnimationFrame(rafId);
    progressEl.style.width = '0%';
    if (prefersReducedMotion) return;
    startTime = performance.now();
    rafId = requestAnimationFrame(animate);
  };

  const pause = () => { paused = true; cancelAnimationFrame(rafId); };
  const resume = () => {
    if (prefersReducedMotion) return;
    paused = false;
    startTime = performance.now() - (parseFloat(progressEl.style.width) / 100) * DURATION;
    rafId = requestAnimationFrame(animate);
  };

  stage.addEventListener('mouseenter', pause);
  stage.addEventListener('mouseleave', resume);
  document.addEventListener('visibilitychange', () => document.hidden ? pause() : resume());

  stage.addEventListener('click', (e) => {
    if (e.target.closest('[data-slide]')) return;
    const slide = e.target.closest('.slide');
    if (slide) {
      const img = $('img', slide);
      const title = $('.slide__title', slide)?.textContent || '';
      if (img && window.__openLightbox) window.__openLightbox(img.src, title);
    }
  });

  stage.querySelector('[data-slide="prev"]').addEventListener('click', (e) => { e.stopPropagation(); index = (index - 1 + total) % total; showSlide(index); });
  stage.querySelector('[data-slide="next"]').addEventListener('click', (e) => { e.stopPropagation(); index = (index + 1) % total; showSlide(index); });

  thumbs.forEach((t, i) => t.addEventListener('click', () => { index = i; showSlide(index); }));

  let sx = 0;
  stage.addEventListener('touchstart', (e) => sx = e.changedTouches[0].screenX, { passive: true });
  stage.addEventListener('touchend', (e) => {
    const d = sx - e.changedTouches[0].screenX;
    if (Math.abs(d) > 50) {
      index = d > 0 ? (index + 1) % total : (index - 1 + total) % total;
      showSlide(index);
    }
  }, { passive: true });

  addEventListener('keydown', (e) => {
    if (e.target.matches('input, textarea, select')) return;
    if (e.key === 'ArrowRight') { index = (index - 1 + total) % total; showSlide(index); }
    if (e.key === 'ArrowLeft') { index = (index + 1) % total; showSlide(index); }
  });

  restart();
})();

/* ============================================================
   FORMS
   ============================================================ */
(function forms() {
  const contactForm = $('#contactForm');
  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!contactForm.checkValidity()) { contactForm.reportValidity(); return; }
    alert('✅ درخواست شما با موفقیت ثبت شد.\nکارشناسان ما به زودی با شما تماس خواهند گرفت.');
    contactForm.reset();
  });

  const nl = $('#newsletterForm');
  nl?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!nl.checkValidity()) { nl.reportValidity(); return; }
    alert('✅ عضویت شما در خبرنامه با موفقیت ثبت شد.');
    nl.reset();
  });
})();

/* ============================================================
   SMOOTH ANCHOR
   ============================================================ */
(function smoothAnchor() {
  $$('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href');
      if (id === '#' || id.length < 2) return;
      const target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      const top = target.getBoundingClientRect().top + scrollY - 90;
      scrollTo({ top, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    });
  });
})();

/* ============================================================
   ACTIVE NAV HIGHLIGHT
   ============================================================ */
(function activeNav() {
  const sections = $$('main section[id]');
  const navLinks = $$('.nav__link');
  if (!sections.length || !navLinks.length) return;

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        navLinks.forEach(l => {
          if (l.getAttribute('href') === '#' + e.target.id) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        });
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });

  sections.forEach(s => io.observe(s));
})();

/* ============================================================
   BACK TO TOP
   ============================================================ */
(function backToTop() {
  const btn = $('#toTop');
  if (!btn) return;
  const update = () => btn.classList.toggle('is-visible', window.scrollY > 600);
  addEventListener('scroll', update, { passive: true });
  update();
  btn.addEventListener('click', () => {
    scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
  });
})();
</script>

